# Copie para .env e preencha. Este arquivo não contém segredos.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
# Chave pública (publishable/anon) — leitura.
SUPABASE_ANON_KEY=
# Chave de serviço (service_role) — SÓ no servidor. Escrita/ingestão.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin das rotas de escrita ──────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
ADMIN_USER=
ADMIN_PASS=
# 1 = app inteiro só abre com o usuário e a senha acima (uso pessoal).
APP_PRIVADO=
# Segredo que assina as sessões do admin (opcional, recomendado). Trocar este
# valor derruba todas as sessões sem invalidar o ADMIN_TOKEN. Sem ele, usa o ADMIN_TOKEN.
SESSION_SECRET=

# ── Limite de uso da IA (compartilhado entre instâncias, via Supabase) ────────
# Requer a migração supabase-backup/migracoes/2026-09-16-cota-de-uso.sql.
# 0 desliga o teto correspondente.
# LIMITE_LLM_POR_DIA_IP=300
# LIMITE_LLM_GLOBAL_POR_DIA=5000

# Tentativas de login de admin por IP a cada 15 minutos (contra força bruta).
# LIMITE_LOGIN_ADMIN=8

# Consultas ao material indexado (/api/trecho) por IP por dia. Cota separada
# da IA: conferir citação não consome o orçamento de perguntas do aluno.
# LIMITE_LEITURA_POR_DIA_IP=600

# ── CORS ────────────────────────────────────────────────────────────────────
# Origens permitidas, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:3000

# ── Orçamento de tempo da função (opcional) ─────────────────────────────────
# Precisa bater com o maxDuration do vercel.json. O backend deriva os timeouts
# das chamadas de IA deste valor, para nunca estourar o limite da plataforma.
# MAX_DURACAO_FUNCAO=60

# ── Provedores de IA (preencha só os que for usar) ──────────────────────────
NOUS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=

# ── Modelo de embeddings da busca ───────────────────────────────────────────
# gte (padrão): gte-small na Edge Function do Supabase.
# mistral: mistral-embed (usa a MISTRAL_API_KEY); cai para o gte se falhar.
# Só ligar depois da migração 2026-09-21-embedding-mistral.sql e de rodar
# scripts/vetorizar_mistral.py. Com a MISTRAL_API_KEY definida, a ingestão
# grava os dois vetores, qualquer que seja este valor.
# EMBEDDINGS_BUSCA=gte
ANYAPI_API_KEY=
ORCAROUTER_API_KEY=
TOGETHER_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
MODELSCOPE_API_KEY=
